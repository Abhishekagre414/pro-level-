# Copy to .env (never commit it) and edit.
# Public hostname Caddy will obtain a certificate for; DNS must already point at this host.
LABDEMO_DOMAIN=labs.example.com

# >= 32 chars. Generate: python -c 'import secrets; print(secrets.token_hex(32))'
# Leave empty to let the app generate one into the instance volume (then back that volume up).
LABDEMO_SECRET_KEY=

# 1 = every learner gets a unique, HMAC-derived flag (copied flags become detectable).
LABDEMO_PER_USER_FLAGS=0
